# ==============================================================================
# Multi-Agent Research Assistant - Environment Configuration
# Copy this file to '.env' and fill in your actual API keys.
# DO NOT commit your real '.env' file to Git!
# ==============================================================================

# Gemini LLM Settings (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector Store (Qdrant - Phase 5)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=research_documents

# Memory & Cache (Redis - Phase 7)
REDIS_URL=redis://localhost:6379/0

# Observability (Langfuse - Phase 9)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Web Search API (Phase 2 - e.g. Tavily free tier or DuckDuckGo)
TAVILY_API_KEY=
